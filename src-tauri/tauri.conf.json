{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strata",
  "version": "2.6.2",
  "identifier": "studio.xiaofang.strata",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Strata",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true,
        "visible": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["strata"],
        "name": "Strata 工程文件",
        "description": "小方工作室 Strata 图像处理软件工程文件",
        "role": "Editor"
      },
      {
        "ext": ["strata-droplet"],
        "name": "Strata Droplet 批处理配方",
        "description": "双击以装载 Strata 批处理配方（Droplet）",
        "role": "Editor"
      },
      {
        "ext": ["png", "jpg", "jpeg", "webp", "bmp", "gif", "tif", "tiff"],
        "name": "图片文件",
        "description": "常见位图图片格式，用 Strata 打开后直接进入编辑",
        "role": "Editor"
      }
    ],
    "publisher": "小方工作室",
    "copyright": "小方工作室 · MIT License",
    "category": "GraphicsAndDesign",
    "shortDescription": "全中文、免费开源的修图与绘画工具（Windows / macOS / Linux）",
    "longDescription": "Strata 是小方工作室自研的全中文、永久免费开源（MIT）的 Photoshop 平替，修图与绘画并列为一级能力，三平台同一份代码。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
