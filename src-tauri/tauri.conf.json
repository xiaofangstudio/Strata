{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strata",
  "version": "0.1.0",
  "identifier": "studio.xiaofang.strata",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Strata",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "小方工作室",
    "copyright": "小方工作室 · MIT License",
    "category": "GraphicsAndDesign",
    "shortDescription": "Windows 优先、全中文、免费开源的修图与绘画工具",
    "longDescription": "Strata 是小方工作室自研的 Windows 优先、全中文、永久免费开源（MIT）的 Photoshop 平替，修图与绘画并列为一级能力。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
